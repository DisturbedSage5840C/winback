# Winback — copy to .env and fill in. .env is gitignored; never commit real keys.

# ---------------------------------------------------------------- database
# The agent and the simulator write as winback_agent (append-only on the fact tables).
WINBACK_DB_URL=postgresql://winback_agent:winback_agent_dev@localhost:55432/winback
# The FastAPI backend reads as winback_reader (SELECT only, no writes at all).
WINBACK_DB_URL_READONLY=postgresql://winback_reader:winback_reader_dev@localhost:55432/winback
# Migrations / sim reset only.
WINBACK_DB_URL_OWNER=postgresql://winback_owner:winback_dev@localhost:55432/winback

# ---------------------------------------------------------------- razorpay
# TEST MODE ONLY. The key id must start with rzp_test_. Anything starting with
# rzp_live_ is rejected at startup by agent/adapters/live_razorpay.py — this system
# has no business holding a live key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# 'remote' -> https://mcp.razorpay.com/mcp over HTTP with Basic auth
# 'local'  -> docker run --rm -i razorpay/mcp over stdio
# 'off'    -> no Razorpay MCP; simulated adapter only (the default for the batch run)
RAZORPAY_MCP_MODE=off
# SPACE-separated, and the names use underscores. razorpay/mcp reads a comma-joined
# value as one toolset name and refuses to start ("toolset orders,payments does not
# exist"); `payment-links` is likewise not a name and `subscriptions` is not a toolset
# in the image at all. This exact value was verified to start and to expose 20 of the
# default 41 tools, including every one the live lane uses. Commas are normalised to
# spaces in agent/mcp_config.py so a stale .env cannot silently disable local mode.
RAZORPAY_MCP_TOOLSETS=orders payments payment_links
RAZORPAY_MCP_READ_ONLY=false

# ---------------------------------------------------------------- execution
# 'simulated' -> the seeded counterfactual oracle (the 500-subscription batch)
# 'live'      -> real Razorpay test-mode API calls (the ~10-20 subscription live cohort)
# Recorded per row in audit_log.execution_mode. Never inferred, always explicit.
WINBACK_EXECUTION_MODE=simulated

# Hard ceiling on how many real API calls a single batch may make. A runaway agent
# loop against a live account is the failure mode worth a cheap counter.
WINBACK_LIVE_CALL_BUDGET=50

# ---------------------------------------------------------------- agent
ANTHROPIC_API_KEY=
WINBACK_AGENT_MODEL=claude-sonnet-5
WINBACK_EXPLAINER_MODEL=claude-opus-5
WINBACK_MAX_TURNS_PER_ITEM=6

# ---------------------------------------------------------------- determinism
# Every oracle coin flip derives from this. Change it and the whole world changes;
# keep it and the committed EVALUATION.md reproduces byte-for-byte.
WINBACK_SEED=20260905
